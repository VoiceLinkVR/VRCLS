<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>VRCLS.Services</RootNamespace>
    <AssemblyName>VRCLS.Services</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinForms" Version="2.2.1" />
    <!-- OpenVR official bindings are included as source (see below). -->
    <PackageReference Include="System.Speech" Version="10.0.2" />
    <PackageReference Include="VRCOscLib" Version="1.6.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="*" />
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
    <!-- Opus 编码库 -->
    <PackageReference Include="Concentus" Version="1.1.7" />
    <PackageReference Include="NetSparkleUpdater.SparkleUpdater" Version="3.0.4" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>


  <!-- Official OpenVR C# bindings (from ValveSoftware/openvr). -->
  <ItemGroup>
    <Compile Include="..\\ref\\openvr\\headers\\openvr_api.cs" Link="VR\\OpenVR\\openvr_api.cs">
      <!-- This is third-party generated interop code; suppress nullable warnings to keep our build output readable. -->
      <NoWarn>$(NoWarn);8602;8603;8605;8618;8625</NoWarn>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\01.VRCLS.Core\01.VRCLS.Core.csproj" />
  </ItemGroup>

</Project>
