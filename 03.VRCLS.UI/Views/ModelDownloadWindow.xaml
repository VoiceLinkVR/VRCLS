<Window x:Class="VRCLS.UI.Views.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x6A21;&#x578B;&#x4E0B;&#x8F7D;"
        Width="520"
        MinWidth="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="1"
                       Margin="0,14,0,0"
                       Opacity="0.82"
                       TextWrapping="Wrap"/>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="12"
                    Background="#11000000"
                    CornerRadius="8">
                <TextBlock x:Name="ModelListTextBlock"
                           TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="3"
                        Margin="0,18,0,0">
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,0,0,8"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="DownloadProgressBar"
                             Height="16"
                             Minimum="0"
                             Maximum="100"/>
            </StackPanel>

            <StackPanel Grid.Row="4"
                        Margin="0,20,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        Padding="16,8"
                        Click="SecondaryButton_Click"/>
                <Button x:Name="PrimaryButton"
                        MinWidth="120"
                        Padding="16,8"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
