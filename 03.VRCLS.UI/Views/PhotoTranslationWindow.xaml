<Window x:Class="VRCLS.UI.Views.PhotoTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource PhotoTranslationWindowTitle}"
        Width="820"
        Height="560"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="White"
        ShowInTaskbar="True"
        Topmost="{Binding IsOverlayPinned}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Camera" Width="24" Height="24" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource PhotoTranslationWindowTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Command="{Binding ClearPhotoTranslationResultsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="14,6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource PhotoTranslationWindowClear}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Background="#1B1E27"
                BorderBrush="#323848"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="32"
                            Visibility="{Binding HasPhotoTranslationResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Camera"
                                             Width="40"
                                             Height="40"
                                             HorizontalAlignment="Center"
                                             Foreground="#60708A"
                                             Opacity="0.9"/>
                    <TextBlock Text="{DynamicResource PhotoTranslationWindowEmpty}"
                               HorizontalAlignment="Center"
                               Foreground="#AAB2C3"
                               FontSize="15"
                               Margin="0,14,0,0"/>
                    <TextBlock Text="{DynamicResource PhotoTranslationWindowPasteHint}"
                               HorizontalAlignment="Center"
                               Foreground="#DDE6F6"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>

                <Grid Visibility="{Binding HasPhotoTranslationResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding PreviousPhotoTranslationResultCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="48"
                            Height="92"
                            Margin="8"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource PhotoTranslationWindowPrevious}">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="32" Height="32"/>
                    </Button>

                    <ContentControl Grid.Column="1"
                                    Margin="0,12"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding CurrentPhotoTranslationResult}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border Background="#242936"
                                        BorderBrush="#3A4254"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                           Foreground="#AAB2C3"
                                                           FontSize="12"/>
                                                <Border Background="#304A75"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        Margin="10,0,0,0"
                                                        Visibility="{Binding IsImageMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{DynamicResource PhotoTranslationModeImage}"
                                                               FontSize="11"
                                                               Foreground="White"/>
                                                </Border>
                                                <Border Background="#315848"
                                                        CornerRadius="4"
                                                        Padding="7,2"
                                                        Margin="10,0,0,0"
                                                        Visibility="{Binding IsTextMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{DynamicResource PhotoTranslationModeText}"
                                                               FontSize="11"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DataContext.CurrentPhotoTranslationPageText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="#DDE6F6"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0"/>

                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.CopyPhotoTranslationResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Width="30"
                                                    Height="30"
                                                    ToolTip="{DynamicResource PhotoTranslationWindowCopy}">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,14,0,0" ClipToBounds="True">
                                            <Image Source="{Binding ResultImagePath}"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsImageMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                            <Grid Visibility="{Binding IsTextMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Background="#1C212D"
                                                        BorderBrush="#333B4E"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{DynamicResource Orig}"
                                                                   Foreground="#AAB2C3"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"/>
                                                        <ScrollViewer Grid.Row="1"
                                                                      Margin="0,10,0,0"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      CanContentScroll="False"
                                                                      PanningMode="VerticalOnly">
                                                            <TextBlock Text="{Binding Original}"
                                                                       Foreground="#E4E8F1"
                                                                       FontSize="18"
                                                                       TextWrapping="Wrap"/>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>

                                                <Border Grid.Column="2"
                                                        Background="#1C212D"
                                                        BorderBrush="#333B4E"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14"
                                                        ClipToBounds="True">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  CanContentScroll="False"
                                                                  PanningMode="VerticalOnly">
                                                        <StackPanel>
                                                            <StackPanel Visibility="{Binding Translation, Converter={StaticResource StringVisibilityConverter}}">
                                                                <TextBlock Text="{DynamicResource T1}"
                                                                           Foreground="#AAB2C3"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Translation}"
                                                                           FontSize="20"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           Margin="0,8,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding Translation2, Converter={StaticResource StringVisibilityConverter}}">
                                                                <TextBlock Text="{DynamicResource T2}"
                                                                           Foreground="#AAB2C3"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Translation2}"
                                                                           FontSize="17"
                                                                           Foreground="#E6EBF5"
                                                                           Margin="0,8,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding Translation3, Converter={StaticResource StringVisibilityConverter}}">
                                                                <TextBlock Text="{DynamicResource T3}"
                                                                           Foreground="#AAB2C3"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Translation3}"
                                                                           FontSize="17"
                                                                           Foreground="#E6EBF5"
                                                                           Margin="0,8,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <Button Grid.Column="2"
                            Command="{Binding NextPhotoTranslationResultCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="48"
                            Height="92"
                            Margin="8"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource PhotoTranslationWindowNext}">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="32" Height="32"/>
                    </Button>
                </Grid>

                <Grid Panel.ZIndex="10"
                      Background="#D9111318"
                      Visibility="{Binding IsPhotoTranslationProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="280">
                        <Grid x:Name="PhotoTranslationProcessingSpinner"
                              Width="70"
                              Height="70"
                              HorizontalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="PhotoTranslationProcessingSpinner"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:1.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Ellipse Stroke="#26334A"
                                     StrokeThickness="5"
                                     Opacity="0.95"/>
                            <Path Stroke="#64B5F6"
                                  StrokeThickness="5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 35,5 A 30,30 0 0 1 65,35"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource PhotoTranslationWindowProcessingTitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,0"/>
                        <TextBlock Text="{DynamicResource PhotoTranslationWindowProcessingSubtitle}"
                                   HorizontalAlignment="Center"
                                   Foreground="#AAB2C3"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <ProgressBar IsIndeterminate="True"
                                     Height="4"
                                     Width="220"
                                     Margin="0,18,0,0"
                                     Foreground="#64B5F6"
                                     Background="#26334A"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
