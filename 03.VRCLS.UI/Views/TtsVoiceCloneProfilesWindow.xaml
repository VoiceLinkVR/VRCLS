<Window x:Class="VRCLS.UI.Views.TtsVoiceCloneProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="音色预设"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}"
        Topmost="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,18">
            <TextBlock Text="音色预设"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="一个预设可以包含多条参考音频配置。适用语言选择“自动语言”时，会作为当前预设的默认声音；更具体的语言配置会优先匹配。"
                       Margin="0,8,0,0"
                       FontSize="13"
                       Opacity="0.72"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Background="#07000000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="预设列表"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,8"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right"
                                                      IsChecked="{Binding Enabled}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Summary}"
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   Opacity="0.68"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2"
                               Margin="0,12,0,0">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnAddPreset"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="新增"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnDuplicatePreset"
                                IsEnabled="{Binding HasSelectedPreset}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="复制"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnRemovePreset"
                                IsEnabled="{Binding HasSelectedPreset}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="删除"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnImportPreset"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileUpload"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="导入"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnExportPreset"
                                IsEnabled="{Binding HasSelectedPreset}"
                                Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDownload"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="导出"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="OnOpenPresetMarket"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Store"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="预设市场"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="18"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    Background="#04000000">
                <Grid>
                    <TextBlock Text="左侧新增或选择一个预设。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.62"
                               Visibility="{Binding HasSelectedPreset, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelectedPreset, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="启用"
                                          IsChecked="{Binding SelectedPreset.Enabled}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="预设详情"
                                           FontWeight="SemiBold"
                                           FontSize="16"/>
                            </DockPanel>

                            <TextBox Margin="0,16,0,0"
                                     Text="{Binding SelectedPreset.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="预设名称"/>

                            <TextBlock Text="参考音频组"
                                       Margin="0,18,0,8"
                                       FontWeight="SemiBold"
                                       Opacity="0.82"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="220"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <ListBox ItemsSource="{Binding SelectedPreset.Profiles}"
                                             SelectedItem="{Binding SelectedPreset.SelectedProfile}"
                                             BorderBrush="{DynamicResource MaterialDesignDivider}"
                                             BorderThickness="1"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="9"
                                                        Margin="0,0,0,6"
                                                        CornerRadius="8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="12"
                                                                   Opacity="0.68"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <WrapPanel Grid.Row="1"
                                               Margin="0,10,0,0">
                                        <Button Content="新增"
                                                Click="OnAddProfile"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="复制"
                                                Click="OnDuplicateProfile"
                                                IsEnabled="{Binding SelectedPreset.HasSelectedProfile}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="删除"
                                                Click="OnRemoveProfile"
                                                IsEnabled="{Binding SelectedPreset.HasSelectedProfile}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <TextBlock Text="选择或新增一条参考音频配置。"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.62"
                                               Visibility="{Binding SelectedPreset.HasSelectedProfile, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                    <StackPanel Visibility="{Binding SelectedPreset.HasSelectedProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right"
                                                      Content="启用"
                                                      IsChecked="{Binding SelectedPreset.SelectedProfile.Enabled}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="参考配置"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"/>
                                        </DockPanel>

                                        <ComboBox Margin="0,12,0,0"
                                                  SelectedValue="{Binding SelectedPreset.SelectedProfile.Provider}"
                                                  SelectedValuePath="Tag"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="适用 TTS 服务商">
                                            <ComboBoxItem Tag="" Content="当前服务商"/>
                                            <ComboBoxItem Tag="qwen" Content="Qwen-TTS"/>
                                            <ComboBoxItem Tag="moss" Content="MOSS-TTS"/>
                                            <ComboBoxItem Tag="omnivoice" Content="OmniVoice-TTS"/>
                                        </ComboBox>

                                        <ComboBox Margin="0,12,0,0"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedValue="{Binding SelectedPreset.SelectedProfile.TargetLanguage}"
                                                  SelectedValuePath="Code"
                                                  DisplayMemberPath="DisplayName"
                                                  IsTextSearchEnabled="True"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="适用语言"/>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding SelectedPreset.SelectedProfile.ReferenceAudioPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="参考音频文件"/>
                                            <Button Grid.Column="2"
                                                    Content="选择"
                                                    Click="OnBrowseReferenceAudio"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        </Grid>

                                        <TextBox Margin="0,12,0,0"
                                                 Text="{Binding SelectedPreset.SelectedProfile.ReferenceText, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="76"
                                                 MaxLength="500"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="参考音频文本（Qwen 必填，不填不能保存）"/>

                                        <ComboBox Margin="0,12,0,0"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  SelectedValue="{Binding SelectedPreset.SelectedProfile.CloneLanguage}"
                                                  SelectedValuePath="Code"
                                                  DisplayMemberPath="DisplayName"
                                                  IsTextSearchEnabled="True"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="克隆/合成语言"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding ValidationMessage}"
                       VerticalAlignment="Center"
                       Foreground="#C62828"
                       FontSize="12"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="确定"
                        Width="110"
                        Height="40"
                        IsDefault="True"
                        Click="OnConfirm"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button Content="取消"
                        Height="40"
                        Margin="12,0,0,0"
                        IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
