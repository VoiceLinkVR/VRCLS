<Window x:Class="VRCLS.UI.Views.EdgeTtsVoicePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource EdgeTtsVoicePickerTitle}"
        Height="720"
        Width="900"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Topmost="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.Resources>
        <DataTemplate x:Key="VoiceItemTemplate">
            <Border Margin="0,0,0,8"
                    Padding="16,14"
                    CornerRadius="12"
                    Background="#0A000000"
                    BorderBrush="#12000000"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38"
                            Height="38"
                            CornerRadius="19"
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            Opacity="0.18"
                            VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Waveform"
                                                 Width="18"
                                                 Height="18"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="14,2,0,0"
                               Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <Border Grid.Column="2"
                            Margin="16,0,0,0"
                            Padding="10,4"
                            CornerRadius="10"
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            Opacity="0.9"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding LanguageLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource EdgeTtsVoicePickerDescription}"
                       FontSize="13"
                       Opacity="0.72"
                       TextWrapping="Wrap"/>

            <materialDesign:Card Padding="8"
                                 UniformCornerRadius="24"
                                 Margin="0,16,0,0"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Search"
                                             Width="24"
                                             Height="24"
                                             VerticalAlignment="Center"
                                             Margin="12,0"
                                             Opacity="0.5"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             materialDesign:HintAssist.Hint="{DynamicResource EdgeTtsVoicePickerSearchHint}"
                             TextChanged="OnSearchTextChanged"/>
                    <Button Grid.Column="2"
                            Content="{DynamicResource EdgeTtsVoicePickerRefresh}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnRefreshClicked"
                            Margin="0,0,8,0"/>
                </Grid>
            </materialDesign:Card>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,16"
                Padding="12"
                CornerRadius="16"
                Background="#08FFFFFF"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1">
            <ListBox x:Name="VoiceListBox"
                     SelectionChanged="OnVoiceSelectionChanged"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemTemplate="{StaticResource VoiceItemTemplate}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <TextBlock Text="Current selection"
                           Opacity="0.6"
                           FontSize="12"/>
                <TextBox x:Name="VoiceInputBox"
                         FontSize="16"
                         FontWeight="SemiBold"
                         BorderThickness="0"
                         Background="Transparent"
                         IsReadOnly="False"
                         Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,12,0"
                        Click="OnUseDefaultClicked"
                        Height="40"
                        Content="{DynamicResource EdgeTtsVoicePickerUseDefault}"/>
                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,12,0"
                        Click="OnPreviewClicked"
                        Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlayCircle"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource EdgeTtsVoicePickerPreview}"/>
                    </StackPanel>
                </Button>
                <Button Content="{DynamicResource EdgeTtsVoicePickerOk}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        IsDefault="True"
                        Click="OnConfirmClicked"
                        Height="40"
                        Width="110"/>
                <Button Content="{DynamicResource EdgeTtsVoicePickerCancel}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="12,0,0,0"
                        Height="40"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
