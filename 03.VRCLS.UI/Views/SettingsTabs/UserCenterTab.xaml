<UserControl x:Class="VRCLS.UI.Views.SettingsTabs.UserCenterTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <Style x:Key="ConnectionEntryButtonStyle"
               TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28">
        <StackPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}"
                    MaxWidth="1120">
            <TextBlock Text="{DynamicResource UserCenterPageTitle}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="{DynamicResource UserCenterPageDescription}"
                       Margin="0,8,0,22"
                       FontSize="13"
                       Opacity="0.72"
                       TextWrapping="Wrap"/>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}"
                                 Padding="0">
                <Border CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#140070F3" Offset="0"/>
                            <GradientStop Color="#0800DFD8" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                                Width="64" Height="64" 
                                CornerRadius="32" 
                                Background="#1A000000" 
                                VerticalAlignment="Top" 
                                Margin="0,0,20,0">
                            <materialDesign:PackIcon Kind="AccountCircleOutline" 
                                                     Width="40" Height="40" 
                                                     HorizontalAlignment="Center" 
                                                     VerticalAlignment="Center" 
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DisplayUsername}"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Margin="0,0,0,2"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding AuthModeSummary}"
                                       FontSize="13"
                                       Opacity="0.72"/>

                            <StackPanel Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="AccountBadgeOutline" Width="16" Height="16" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UsernameAliasSummary}" FontSize="13" Opacity="0.82" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <materialDesign:PackIcon Kind="Fingerprint" Width="16" Height="16" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UserUuidSummary}" FontSize="13" Opacity="0.82" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16" Opacity="0.6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EmailSummary}" FontSize="13" Opacity="0.82" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <TextBlock Text="{DynamicResource UserCenterProfileSyncHint}"
                                       Margin="0,16,0,0"
                                       FontSize="12"
                                       Opacity="0.6"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Border Padding="10,6" 
                                    CornerRadius="16" 
                                    Background="#14000000">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CircleMedium" 
                                                             Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusColorConverter}}" 
                                                             VerticalAlignment="Center" 
                                                             Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding ConnectionBadgeStatus}" 
                                                FontSize="13" 
                                                FontWeight="SemiBold" 
                                                Foreground="{Binding ConnectionStatus, Converter={StaticResource StatusColorConverter}}"
                                                VerticalAlignment="Center"
                                                MaxWidth="180"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding ConnectionStatus}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionSectionTitle}"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="{Binding ConnectionSectionDescription}"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <Border Margin="0,18,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#0A000000">
                        <DockPanel LastChildFill="False">
                            <ToggleButton DockPanel.Dock="Right"
                                          IsChecked="{Binding UseLegacyBackendApi}"
                                          Style="{StaticResource SettingsToggleButtonStyle}"/>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource UserCenterLegacyCompatibilityTitle}"
                                           Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                <TextBlock Text="{DynamicResource UserCenterLegacyCompatibilityDescription}"
                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="18"
                            CornerRadius="12"
                            Background="#100070F3"
                            BorderBrush="#330070F3"
                            BorderThickness="1"
                            Visibility="{Binding ShouldShowLegacyMigrationGuide, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#180070F3"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Top">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="24"
                                                         Height="24"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="0,0,18,0">
                                <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideTitle}"
                                           Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideDescription}"
                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideStepLogin}"
                                               FontSize="12"
                                               Opacity="0.72"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideStepBind}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Opacity="0.72"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideStepReturn}"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Opacity="0.72"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Grid.Column="2"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Command="{Binding OpenWebsiteUserCenterCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="0,0,10,8">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="OpenInNew"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideOpenWebsiteButton}"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StartWebsiteLoginForMigrationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource UserCenterLegacyMigrationGuideStartLoginButton}"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#0A000000"
                            Visibility="{Binding IsModernBackendApi, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenConnectionEntryCommand}"
                                        Style="{StaticResource ConnectionEntryButtonStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding WebsiteAuthorizationStatus}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding WebsiteAuthorizationStatus, Converter={StaticResource StringVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding WebsiteAuthorizationUrl}"
                                                   Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Opacity="0.72"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding WebsiteAuthorizationUrl, Converter={StaticResource StringVisibilityConverter}}"/>
                                        <TextBlock Text="{DynamicResource UserCenterSessionHealthy}"
                                                   FontSize="13"
                                                   Opacity="0.72"
                                                   Visibility="{Binding WebsiteAuthorizationStatus, Converter={StaticResource InverseStringVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ConnectionEntryHint}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Opacity="0.56"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding OpenWebsiteUserCenterCommand}"
                                            Content="{DynamicResource UserCenterAccountCenterButton}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,10,0"/>
                                    <Button Command="{Binding ResetToDefaultCommand}"
                                            Visibility="{Binding IsWebsiteAuthorizedSession, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                            Content="{Binding ResetLoginButtonText}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,10,0"/>
                                    <Button Command="{Binding ResetToDefaultCommand}"
                                            Content="{DynamicResource UserCenterLogoutButton}"
                                            Visibility="{Binding IsWebsiteAuthorizedSession, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,10,0"/>
                                    <Button Command="{Binding LoginCommand}"
                                            Content="{Binding LoginButtonText}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#0A000000"
                            Visibility="{Binding UseLegacyBackendApi, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Margin="0,0,8,0"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="{DynamicResource 用户名}"/>

                                <PasswordBox x:Name="PasswordBox"
                                             Grid.Column="1"
                                             Margin="8,0,0,0"
                                             PasswordChanged="OnPasswordChanged"
                                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                             materialDesign:HintAssist.Hint="{DynamicResource 密码}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,16,0,0">
                                <Button Command="{Binding ResetToDefaultCommand}"
                                        Content="{Binding ResetLoginButtonText}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,10,0"/>
                                <Button Command="{Binding LoginCommand}"
                                        Content="{Binding LoginButtonText}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander Header="{DynamicResource UserCenterAdvancedBaseUrlHeader}"
                              Margin="0,12,0,0"
                              Background="Transparent"
                              BorderThickness="0">
                        <Grid Margin="0,12,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="340"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource UserCenterBaseUrlTitle}"
                                           Style="{StaticResource SettingsRowTitleTextStyle}"/>
                                <TextBlock Text="{Binding BaseUrlDescription}"
                                           Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BaseUrl, UpdateSourceTrigger=LostFocus}"
                                         IsReadOnly="{Binding IsBaseUrlLocked}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="{Binding BaseUrlHint}"/>
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding ToggleBaseUrlLockCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="{DynamicResource UnlockBaseUrlButtonTip}">
                                    <Grid>
                                        <materialDesign:PackIcon Kind="Lock"
                                                                 Width="18" Height="18"
                                                                 Visibility="{Binding IsBaseUrlLocked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <materialDesign:PackIcon Kind="LockOpenVariant"
                                                                 Width="18" Height="18"
                                                                 Visibility="{Binding IsBaseUrlLocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}"
                                 Visibility="{Binding IsModernBackendApi, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource UserCenterQuotaSectionTitle}"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource UserCenterQuotaSectionDescription}"
                                       Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding RefreshAccountOverviewCommand}"
                                ToolTip="{DynamicResource UserCenterRefreshDataTooltip}"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="20"
                                CornerRadius="12"
                                Background="#0F000000">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="ChartPie" Width="20" Height="20" Opacity="0.5" DockPanel.Dock="Right"/>
                                    <TextBlock Text="{DynamicResource UserCenterRemainingDaily}" FontSize="13" FontWeight="Medium" Opacity="0.8"/>
                                </DockPanel>
                                <TextBlock Text="{Binding AccountRemainingDailySummary}"
                                           Style="{StaticResource SettingsMetricValueTextStyle}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock FontSize="12" Opacity="0.6">
                                    <Run Text="{DynamicResource UserCenterDailyLimitPrefix}"/>
                                    <Run Text="{Binding AccountDailyLimitSummary}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding AccountAddonBalanceSummary}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Opacity="0.6"
                                           Visibility="{Binding AccountAddonBalanceSummary, Converter={StaticResource StringVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="20"
                                CornerRadius="12"
                                Background="#0F000000">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20" Opacity="0.5" DockPanel.Dock="Right"/>
                                    <TextBlock Text="{DynamicResource UserCenterExpirationCardTitle}" FontSize="13" FontWeight="Medium" Opacity="0.8"/>
                                </DockPanel>
                                <TextBlock Text="{Binding AccountExpirationSummary}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AccountUsageSummary}"
                                           FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Expander Header="{DynamicResource UserCenterUsageRangeQueryHeader}"
                              Margin="0,20,0,0"
                              Background="Transparent"
                              BorderThickness="0">
                        <StackPanel Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <DatePicker Grid.Column="0" Width="140"
                                            SelectedDate="{Binding AccountUsageStartDate, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="{DynamicResource UserCenterUsageStartDateHint}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource UserCenterUsageDateTo}" Margin="16,0" VerticalAlignment="Center" Opacity="0.5"/>
                                <DatePicker Grid.Column="2" Width="140"
                                            SelectedDate="{Binding AccountUsageEndDate, Mode=TwoWay}"
                                            materialDesign:HintAssist.Hint="{DynamicResource UserCenterUsageEndDateHint}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                
                                <Button Grid.Column="4"
                                        Command="{Binding QueryAccountUsageCommand}"
                                        Content="{DynamicResource UserCenterUsageQueryButton}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>

                            <TextBlock Text="{Binding AccountUsageStatus}"
                                       Margin="0,12,0,0"
                                       FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       Visibility="{Binding AccountUsageStatus, Converter={StaticResource StringVisibilityConverter}}"/>

                            <TextBox Text="{Binding AccountUsageRangeSummary}"
                                     IsReadOnly="True"
                                     Margin="0,16,0,12"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="{DynamicResource UserCenterUsageRangeSummaryHint}"
                                     Visibility="{Binding AccountUsageRangeSummary, Converter={StaticResource StringVisibilityConverter}}"/>

                            <DataGrid ItemsSource="{Binding AccountUsageDailyStats}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      Background="Transparent"
                                      BorderThickness="1"
                                      BorderBrush="#1A000000"
                                      MinHeight="180" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource UserCenterUsageColumnDate}" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource UserCenterUsageColumnSuccessCount}" Binding="{Binding SuccessCount}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource UserCenterUsageColumnDailyLimit}" Binding="{Binding DailyLimit}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource UserCenterUsageColumnRemaining}" Binding="{Binding RemainingDaily}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
