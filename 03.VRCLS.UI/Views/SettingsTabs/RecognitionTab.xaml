<UserControl x:Class="VRCLS.UI.Views.SettingsTabs.RecognitionTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28">
        <StackPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}"
                    MaxWidth="1120">
            <TextBlock Text="语音识别"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="先确定采集入口和自动启动行为，再设置触发方式、VAD 和本地识别参数。"
                       Margin="0,8,0,22"
                       FontSize="13"
                       Opacity="0.68"
                       TextWrapping="Wrap"/>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right"
                                      IsChecked="{Binding AutoStartMic}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"/>
                        <StackPanel>
                            <TextBlock Text="麦克风识别"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                            <TextBlock Text="选择主麦克风，并决定应用启动时是否自动开始识别。"
                                       Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <ComboBox ItemsSource="{Binding MicDevices}"
                              SelectedValue="{Binding MicName}"
                              MinWidth="460"
                              ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="麦克风设备"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="触发模式"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="选择常开、按键切换或按住说话。"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding VoiceMode}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="常开 (实时识别)"/>
                            <ComboBoxItem Content="按键切换 (Toggle)"/>
                            <ComboBoxItem Content="按住说话 (Push-to-Talk)"/>
                        </ComboBox>
                    </Grid>

                    <TextBox Margin="0,16,0,0"
                             Text="{Binding VoiceHotKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowMicHotKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="切换热键 (如: &lt;alt&gt;+1)"/>

                    <TextBox Margin="0,14,0,0"
                             Text="{Binding MicPressingKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowMicPressKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="按住按键 (如: v)"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right"
                                      IsChecked="{Binding AutoStartDesktop}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"/>
                        <StackPanel>
                            <TextBlock Text="监听音频识别"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                            <TextBlock Text="为系统监听音频或指定应用捕获选择来源，并决定是否自动启动。"
                                       Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="监听来源"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="在系统监听音频和指定应用音频之间切换。"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding DesktopAudioSourceMode}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}">
                            <ComboBoxItem Content="系统监听音频"/>
                            <ComboBoxItem Content="指定应用音频"
                                          IsEnabled="{Binding IsApplicationAudioCaptureSupported}"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock Text="{Binding ApplicationAudioSupportStatusText}"
                               Margin="0,0,0,14"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsApplicationAudioCaptureSupported, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <ComboBox ItemsSource="{Binding DesktopAudioDevices}"
                              SelectedValue="{Binding GameMicName}"
                              Visibility="{Binding ShowDesktopLoopbackDeviceSelector, Converter={StaticResource BooleanToVisibilityConverter}}"
                              MinWidth="460"
                              ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="监听设备"/>

                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding ShowApplicationAudioProcessSelector, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding ApplicationAudioProcesses}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ProcessId"
                                  SelectedValue="{Binding SelectedApplicationAudioProcessId}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="目标应用程序"/>
                        <Button Grid.Column="2"
                                Command="{Binding RefreshApplicationAudioProcessesCommand}"
                                Content="刷新应用列表"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>

                    <TextBlock Text="{DynamicResource 应用监听音频说明}"
                               Margin="0,16,0,0"
                               FontSize="12"
                               Opacity="0.68"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowApplicationAudioProcessSelector, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ComboBox Margin="0,16,0,0"
                              SelectedIndex="{Binding GameVoiceMode}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        <ComboBoxItem Content="常开 (实时识别)"/>
                        <ComboBoxItem Content="按键切换 (Toggle)"/>
                        <ComboBoxItem Content="按住说话 (Push-to-Talk)"/>
                    </ComboBox>

                    <TextBox Margin="0,14,0,0"
                             Text="{Binding GameVoiceHotKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowGameHotKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="切换热键 (如: &lt;alt&gt;+2)"/>

                    <TextBox Margin="0,14,0,0"
                             Text="{Binding CapPressingKey, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ShowGamePressKey, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="按住按键 (如: b)"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="VAD 校准"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="校准后可以直接在这里微调，不再额外折叠显示。"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="18"
                                CornerRadius="14"
                                Background="#0A000000"
                                BorderBrush="#14000000"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="麦克风 VAD"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="校准"
                                            Click="OnOpenMicVadCalibration"/>
                                </DockPanel>

                                <TextBox Text="{Binding MicVadMinSilenceDuration, StringFormat={}{0:F2}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="最短静音分段 (秒)"/>
                                <Slider Margin="0,8,0,12"
                                        Minimum="0.10"
                                        Maximum="1.50"
                                        TickFrequency="0.05"
                                        Value="{Binding MicVadMinSilenceDuration}"/>

                                <TextBox Text="{Binding MicVadThreshold, StringFormat={}{0:F2}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="VAD 阈值"/>
                                <Slider Margin="0,8,0,12"
                                        Minimum="0.01"
                                        Maximum="0.99"
                                        TickFrequency="0.01"
                                        Value="{Binding MicVadThreshold}"/>

                                <TextBox Text="{Binding MicVadMaxSegmentSeconds, StringFormat={}{0:F0}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="最大片段时长 (秒)"/>
                                <Slider Margin="0,8,0,0"
                                        Minimum="1"
                                        Maximum="60"
                                        TickFrequency="1"
                                        Value="{Binding MicVadMaxSegmentSeconds}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="18"
                                CornerRadius="14"
                                Background="#0A000000"
                                BorderBrush="#14000000"
                                BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock Text="监听音频 VAD"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Content="校准"
                                            Click="OnOpenDesktopVadCalibration"/>
                                </DockPanel>

                                <TextBox Text="{Binding DesktopVadMinSilenceDuration, StringFormat={}{0:F2}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="最短静音分段 (秒)"/>
                                <Slider Margin="0,8,0,12"
                                        Minimum="0.10"
                                        Maximum="1.50"
                                        TickFrequency="0.05"
                                        Value="{Binding DesktopVadMinSilenceDuration}"/>

                                <TextBox Text="{Binding DesktopVadThreshold, StringFormat={}{0:F2}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="VAD 阈值"/>
                                <Slider Margin="0,8,0,12"
                                        Minimum="0.01"
                                        Maximum="0.99"
                                        TickFrequency="0.01"
                                        Value="{Binding DesktopVadThreshold}"/>

                                <TextBox Text="{Binding DesktopVadMaxSegmentSeconds, StringFormat={}{0:F0}}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="最大片段时长 (秒)"/>
                                <Slider Margin="0,8,0,0"
                                        Minimum="1"
                                        Maximum="60"
                                        TickFrequency="1"
                                        Value="{Binding DesktopVadMaxSegmentSeconds}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right"
                                      IsChecked="{Binding UseLocalRecognition}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"/>
                        <StackPanel>
                            <TextBlock Text="本地语音识别（仅麦克风）"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                            <TextBlock Text="本地 Sherpa 流式模型仅用于麦克风；监听音频不支持本地识别模型。"
                                       Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="{Binding LocalModelStatusText}"
                               FontSize="12"
                               Foreground="{Binding LocalModelStatusColor}"
                               Visibility="{Binding UseLocalRecognition, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding UseLocalRecognition, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="断句静音时长"
                                   Style="{StaticResource SettingsRowTitleTextStyle}"/>
                        <TextBlock Text="控制本地流式识别在结束当前句子前等待多久。"
                                   Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        <TextBox Margin="0,14,0,0"
                                 Width="160"
                                 Text="{Binding LocalStreamingEndpointSilenceSeconds, StringFormat={}{0:F2}}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="断句静音时长 (秒)"/>
                        <Slider Margin="0,8,0,0"
                                Minimum="0.8"
                                Maximum="3.0"
                                TickFrequency="0.05"
                                Value="{Binding LocalStreamingEndpointSilenceSeconds}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
