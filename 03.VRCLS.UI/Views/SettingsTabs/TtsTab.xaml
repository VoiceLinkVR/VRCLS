<UserControl x:Class="VRCLS.UI.Views.SettingsTabs.TtsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28">
        <StackPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}"
                    MaxWidth="1120">
            <TextBlock Text="语音合成 (TTS)"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="在一个区域里直接完成引擎、输出、音色、语速和打断策略设置。"
                       Margin="0,8,0,22"
                       FontSize="13"
                       Opacity="0.68"
                       TextWrapping="Wrap"/>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right"
                                  IsChecked="{Binding EnableTts}"
                                  Style="{StaticResource SettingsToggleButtonStyle}"/>
                    <StackPanel>
                        <TextBlock Text="启用 TTS 播报"
                                   Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                        <TextBlock Text="统一控制是否播报原文或译文。"
                                   Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                    </StackPanel>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}"
                                 Visibility="{Binding EnableTts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="引擎与音色"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="选择引擎、扬声器设备、音色、语速和播报策略。"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <ComboBox Margin="0,18,0,0"
                              SelectedIndex="{Binding TtsEngine}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="引擎类型">
                        <ComboBoxItem Content="服务器 TTS"/>
                        <ComboBoxItem Content="本地系统 TTS"/>
                    </ComboBox>

                    <ComboBox Margin="0,14,0,0"
                              SelectedValue="{Binding TtsProvider}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Visibility="{Binding IsServerTtsEngine, Converter={StaticResource BooleanToVisibilityConverter}}"
                              materialDesign:HintAssist.Hint="服务端 TTS">
                        <ComboBoxItem Tag="edge"
                                      Content="Edge-TTS"/>
                        <ComboBoxItem Tag="qwen"
                                      Content="Qwen-TTS"/>
                    </ComboBox>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding ShowQwenTtsToneSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox SelectedIndex="{Binding QwenTtsToneMode}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Qwen 语气控制">
                            <ComboBoxItem Content="自动"/>
                            <ComboBoxItem Content="指定"/>
                        </ComboBox>

                        <ComboBox Margin="0,10,0,0"
                                  SelectedValue="{Binding QwenTtsInstruct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Visibility="{Binding IsQwenTtsToneSpecified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  materialDesign:HintAssist.Hint="常用语气预设">
                            <ComboBoxItem Tag="请用稳定、自然、克制的语气朗读，语速均匀，情绪变化小，不要夸张，不要突然升降调。"
                                          Content="稳定自然"/>
                            <ComboBoxItem Tag="请用温柔、亲切、放松的语气朗读，音量适中，节奏舒缓。"
                                          Content="温柔亲切"/>
                            <ComboBoxItem Tag="请用清晰、平稳、专业的播报语气朗读，减少情绪起伏，重点词稍作强调。"
                                          Content="清晰播报"/>
                            <ComboBoxItem Tag="请用轻快、友好、有活力的语气朗读，但不要夸张。"
                                          Content="轻快友好"/>
                            <ComboBoxItem Tag="请用冷静、低起伏、偏机械感的语气朗读，保持稳定节奏。"
                                          Content="冷静低起伏"/>
                        </ComboBox>

                        <Grid Margin="0,10,0,0"
                              Visibility="{Binding IsQwenTtsToneSpecified, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding QwenTtsInstruct, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="86"
                                     MaxLength="300"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="指定语气"/>

                            <Border Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="8,8,0,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    ToolTipService.InitialShowDelay="200">
                                <Border.ToolTip>
                                    <ToolTip MaxWidth="360">
                                        <TextBlock Text="用一句自然语言描述希望的朗读方式，可以包含语气、情绪强度、语速、音调起伏和禁忌。例：请用稳定、自然、克制的语气朗读，语速均匀，情绪变化小，不要夸张。"
                                                   TextWrapping="Wrap"/>
                                    </ToolTip>
                                </Border.ToolTip>
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="22"
                                                         Height="22"
                                                         Opacity="0.72"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <ComboBox Margin="0,14,0,0"
                              ItemsSource="{Binding TtsOutputDevices}"
                              SelectedValue="{Binding TtsOutputName}"
                              MinWidth="460"
                              ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="输出设备"/>

                    <Grid Margin="0,14,0,0"
                          Visibility="{Binding IsServerTtsEngine, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding TtsVoiceName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{Binding TtsVoiceHint}"/>
                        <Button Grid.Column="2"
                                Content="{DynamicResource 'Pick Voice'}"
                                Click="OnOpenEdgeTtsVoicePicker"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>

                    <TextBlock Margin="0,16,0,0"
                               Text="{Binding TtsSpeed, StringFormat=语速 {0:F1}x}"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"/>
                    <Slider Margin="0,8,0,0"
                            Minimum="0.5"
                            Maximum="2.0"
                            TickFrequency="0.1"
                            Value="{Binding TtsSpeed}"/>

                    <ComboBox Margin="0,14,0,0"
                              SelectedIndex="{Binding TtsInterruptMode}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="播报中断策略">
                        <ComboBoxItem Content="新消息打断当前播报"/>
                        <ComboBoxItem Content="排队等待顺序播报"/>
                    </ComboBox>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}"
                                 Visibility="{Binding EnableTts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="播报内容"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="选择麦克风和监听音频在识别完成后需要播报的字段。"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <TextBlock Text="麦克风输入后播报:"
                               Margin="0,18,0,8"
                               FontWeight="SemiBold"
                               Opacity="0.82"/>
                    <WrapPanel>
                        <CheckBox Content="原文"
                                  IsChecked="{Binding MicTtsSpeakOriginal}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文1"
                                  IsChecked="{Binding MicTtsSpeakTranslation1}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文2"
                                  IsChecked="{Binding MicTtsSpeakTranslation2}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文3"
                                  IsChecked="{Binding MicTtsSpeakTranslation3}"
                                  Margin="0,0,16,8"/>
                    </WrapPanel>

                    <TextBlock Text="监听音频识别后播报:"
                               Margin="0,14,0,8"
                               FontWeight="SemiBold"
                               Opacity="0.82"/>
                    <WrapPanel>
                        <CheckBox Content="原文"
                                  IsChecked="{Binding DesktopTtsSpeakOriginal}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文1"
                                  IsChecked="{Binding DesktopTtsSpeakTranslation1}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文2"
                                  IsChecked="{Binding DesktopTtsSpeakTranslation2}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="译文3"
                                  IsChecked="{Binding DesktopTtsSpeakTranslation3}"
                                  Margin="0,0,16,8"/>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}"
                                 Visibility="{Binding EnableTts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="试听"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="试听当前音色、输出设备和语速组合。"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding TtsTestText}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="TTS 测试文本"/>
                        <Button Grid.Column="2"
                                Command="{Binding TestTtsCommand}"
                                Content="试听"
                                Style="{StaticResource MaterialDesignRaisedButton}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
