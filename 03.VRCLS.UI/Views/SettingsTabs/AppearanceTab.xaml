<UserControl x:Class="VRCLS.UI.Views.SettingsTabs.AppearanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="28">
        <StackPanel Width="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=ViewportWidth}"
                    MaxWidth="1120">
            <TextBlock Text="{DynamicResource '外观与工具'}"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"/>
            <TextBlock Text="{DynamicResource AppearancePageDescription}"
                       Margin="0,8,0,22"
                       FontSize="13"
                       Opacity="0.68"
                       TextWrapping="Wrap"/>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AppearanceUiSettingsTitle}"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="{DynamicResource AppearanceUiSettingsDescription}"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <Grid Margin="0,18,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource UiLanguageTitle}"
                                   Style="{StaticResource SettingsRowTitleTextStyle}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding UiLanguages}"
                                  SelectedValue="{Binding UiLanguage}"
                                  SelectedValuePath="Code"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource DarkModeTitle}"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource DarkModeDescription}"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>

                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding DarkMode}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource MainWindowDefaultSizeTitle}"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource MainWindowDefaultSizeDescription}"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBox Text="{Binding OverlayWidth}"
                                     materialDesign:HintAssist.Hint="{DynamicResource OverlayWidthHintWithExample}"
                                     Width="88"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,12,0"/>
                            <TextBlock Text="x"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Opacity="0.5"
                                       Margin="0,0,12,0"/>
                            <TextBox Text="{Binding OverlayHeight}"
                                     materialDesign:HintAssist.Hint="{DynamicResource OverlayHeightHintWithExample}"
                                     Width="88"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource MainWindowBackgroundOpacityTitle}"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource MainWindowBackgroundOpacityDescription}"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                Value="{Binding MainWindowBackgroundOpacityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                Margin="16,0,12,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MainWindowBackgroundOpacityPercentText}"
                                   Style="{StaticResource SettingsRowTitleTextStyle}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SteamVrPanelTextColorSettingsTitle}"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="{DynamicResource SteamVrPanelTextColorSettingsDescription}"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SteamVrMicTextColorTitle}"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource SteamVrMicTextColorDescription}"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SteamVrMicTextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{DynamicResource SteamVrTextColorHint}"/>
                        <Border Grid.Column="4"
                                Width="28"
                                Height="28"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Background="{Binding SteamVrMicTextColorBrush}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SteamVrDesktopTextColorTitle}"
                                       Style="{StaticResource SettingsRowTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource SteamVrDesktopTextColorDescription}"
                                       Style="{StaticResource SettingsRowDescriptionTextStyle}"/>
                        </StackPanel>
                        <TextBox Grid.Column="2"
                                 Text="{Binding SteamVrDesktopTextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{DynamicResource SteamVrTextColorHint}"/>
                        <Border Grid.Column="4"
                                Width="28"
                                Height="28"
                                CornerRadius="4"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                Background="{Binding SteamVrDesktopTextColorBrush}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,18">
                        <ToggleButton DockPanel.Dock="Right"
                                      IsChecked="{Binding CopyBox}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ClipboardAssistTitle}"
                                       Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                            <TextBlock Text="{DynamicResource ClipboardAssistDescription}"
                                       Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <WrapPanel>
                        <CheckBox Content="{DynamicResource 'Orig'}"
                                  IsChecked="{Binding CopyOriginal}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="{DynamicResource 'T1'}"
                                  IsChecked="{Binding CopyTranslation1}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="{DynamicResource 'T2'}"
                                  IsChecked="{Binding CopyTranslation2}"
                                  Margin="0,0,16,8"/>
                        <CheckBox Content="{DynamicResource 'T3'}"
                                  IsChecked="{Binding CopyTranslation3}"
                                  Margin="0,0,16,8"/>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource SettingsSectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource RuntimeLogs}"
                               Style="{StaticResource SettingsSectionTitleTextStyle}"/>
                    <TextBlock Text="保留日志查看，并把刷新、自动刷新和打开日志文件放在同一块。"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"/>

                    <WrapPanel Margin="0,18,0,0"
                               ItemHeight="40">
                        <TextBlock Text="{DynamicResource LogAutoRefresh}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8"/>
                        <ToggleButton IsChecked="{Binding IsLogAutoRefreshEnabled}"
                                      Style="{StaticResource SettingsToggleButtonStyle}"
                                      Margin="0,0,16,8"/>
                        <Button Content="{DynamicResource Refresh}"
                                Command="{Binding RefreshLogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,8"/>
                        <Button Content="{DynamicResource OpenLogFile}"
                                Command="{Binding OpenLogFileCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,8"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding CurrentSessionLogPath}"
                               Style="{StaticResource SettingsSectionDescriptionTextStyle}"
                               Margin="0,10,0,0"/>

                    <TextBox Margin="0,14,0,0"
                             Text="{Binding CurrentSessionLogText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Height="260"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
