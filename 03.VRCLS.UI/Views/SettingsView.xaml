<UserControl x:Class="VRCLS.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:VRCLS.UI.Controls"
             xmlns:tabs="clr-namespace:VRCLS.UI.Views.SettingsTabs"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1100"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <DataTemplate x:Key="UserCenterTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:UserCenterTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecognitionTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:RecognitionTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TranslationTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:TranslationTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TtsTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:TtsTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VrIntegrationTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:VrIntegrationTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VoiceControlTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:VoiceControlTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AppearanceTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:AppearanceTab/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UpdateTabContentTemplate">
            <Border Padding="32,24,32,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <tabs:UpdateTab/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay}"
                TabStripPlacement="Left"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Style="{StaticResource MaterialDesignNavigationRailTabControl}">

        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignNavigationRailTabItem}">
                <Setter Property="Height" Value="80"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="MinWidth" Value="110"/>
                <Setter Property="Margin" Value="4,4"/>
            </Style>

            <Style x:Key="DeferredSettingsTabContentStyle" TargetType="{x:Type controls:DeferredContentControl}">
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </TabControl.Resources>

        <TabItem ToolTip="{DynamicResource '用户中心'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="AccountNetwork" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource '用户中心'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource UserCenterTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource '麦克风、系统音频与识别设置'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="Microphone" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource '语音识别'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource RecognitionTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource '语言、翻译引擎与识别模型'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="Translate" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource '翻译'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource TranslationTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource '文本转语音 (TTS)'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="TextToSpeech" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource 'TTS'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource TtsTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource 'VRChat OSC与SteamVR集成'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="VirtualReality" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource 'VR集成'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource VrIntegrationTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource '语音控制设置'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="MicrophoneMessage" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource '语音控制'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource VoiceControlTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource '外观设置与工具'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="PaletteOutline" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource '外观'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource AppearanceTabContentTemplate}"/>
        </TabItem>

        <TabItem ToolTip="{DynamicResource 'App/model/translation updates'}">
            <TabItem.Header>
                <StackPanel>
                    <materialDesign:PackIcon Kind="Update" Width="26" Height="26" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource 'Update'}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem.Header>
            <controls:DeferredContentControl Style="{StaticResource DeferredSettingsTabContentStyle}"
                                             IsContentActivated="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=IsSelected}"
                                             DeferredContentTemplate="{StaticResource UpdateTabContentTemplate}"/>
        </TabItem>
    </TabControl>
</UserControl>
