<Application x:Class="VRCLS.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Converters="clr-namespace:VRCLS.UI.Converters"
             Exit="OnExit"
             DispatcherUnhandledException="OnDispatcherUnhandledException"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                    <ResourceDictionary Source="Resources/Strings.zh.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <!-- Value Converters -->
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
                <Converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
                <Converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
                <Converters:VolumeToPercentageConverter x:Key="VolumeToPercentageConverter" />
                <Converters:ListeningStatusConverter x:Key="ListeningStatusConverter" />
                <Converters:ListeningColorConverter x:Key="ListeningColorConverter" />
                <Converters:StatusColorConverter x:Key="StatusColorConverter" />
                <Converters:SourceToColorConverter x:Key="SourceToColorConverter" />
                <Converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
                <Converters:InverseStringVisibilityConverter x:Key="InverseStringVisibilityConverter" />
                <Converters:StringEqualityToVisibilityConverter x:Key="StringEqualityToVisibilityConverter" />
                <Converters:IntEqualityConverter x:Key="IntEqualityConverter" />
                <Converters:IntEqualityToVisibilityConverter x:Key="IntEqualityToVisibilityConverter" />
                <Converters:MultiAndVisibilityConverter x:Key="MultiAndVisibilityConverter" />

                <!-- Custom Toggle Switch Style - Larger and easier to see -->
                <Style x:Key="LargeSwitchToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
                    <Setter Property="Width" Value="56"/>
                    <Setter Property="Height" Value="28"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>

                <Style x:Key="SettingsSectionCardStyle" TargetType="materialDesign:Card">
                    <Setter Property="Padding" Value="24"/>
                    <Setter Property="Margin" Value="0,0,0,18"/>
                    <Setter Property="UniformCornerRadius" Value="14"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>

                <Style x:Key="SettingsSectionTitleTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="18"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>

                <Style x:Key="SettingsSectionDescriptionTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Opacity" Value="0.68"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>

                <Style x:Key="SettingsRowTitleTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>

                <Style x:Key="SettingsRowDescriptionTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Opacity" Value="0.62"/>
                    <Setter Property="Margin" Value="0,3,0,0"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>

                <Style x:Key="SettingsMetricValueTextStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="28"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>

                <Style x:Key="SettingsSectionIconStyle" TargetType="materialDesign:PackIcon">
                    <Setter Property="Width" Value="20"/>
                    <Setter Property="Height" Value="20"/>
                    <Setter Property="Margin" Value="0,2,14,0"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                </Style>

                <Style x:Key="SettingsToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource LargeSwitchToggleButton}">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </ResourceDictionary>
        </Application.Resources>
</Application>
