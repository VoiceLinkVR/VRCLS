    <sys:String x:Key="QuickStartManualTitle">手动发送</sys:String>
    <sys:String x:Key="QuickStartManualDescription">底部输入框适合临时打字、发送 OSC 文本，或者快速测试当前翻译目标语言。</sys:String>
    <sys:String x:Key="QuickStartSettingsTitle">设置中心</sys:String>
