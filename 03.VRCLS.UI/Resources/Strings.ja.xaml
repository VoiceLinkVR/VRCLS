    <sys:String x:Key="点击 开/关 桌面音频监听">デスクトップ音声のリスニングを開始/停止</sys:String>
    <sys:String x:Key="等待下一张 VRChat 照片并进行拍照翻译">次の VRChat 写真を待って翻訳</sys:String>
    <sys:String x:Key="粘贴">貼り付け</sys:String>
    <sys:String x:Key="发送翻译">翻訳を送信</sys:String>
    <sys:String x:Key="输入文字并发送 OSC 翻译">テキストを入力して OSC 翻訳を送信</sys:String>
    <sys:String x:Key="置顶">最前面に固定</sys:String>
    <sys:String x:Key="最小化">最小化</sys:String>
    <sys:String x:Key="全屏/窗口化">全画面/ウィンドウ</sys:String>
    <sys:String x:Key="关闭">閉じる</sys:String>
    <sys:String x:Key="AppearanceUiSettingsTitle">UI 設定</sys:String>
    <sys:String x:Key="AppearanceUiSettingsDescription">インターフェイス言語とメインウィンドウの既定サイズを変更します。</sys:String>
    <sys:String x:Key="AppearancePageDescription">インターフェイス言語、ウィンドウサイズ、補助ツールをここにまとめています。</sys:String>
    <sys:String x:Key="SteamVrPanelTextColorSettingsTitle">SteamVR パネル文字色</sys:String>
    <sys:String x:Key="SteamVrPanelTextColorSettingsDescription">HEX 値で掌パネルのソース別文字色を設定し、マイクとリスニング音声を区別しやすくします。</sys:String>
    <sys:String x:Key="SteamVrMicTextColorTitle">マイク結果の文字色</sys:String>
    <sys:String x:Key="SteamVrMicTextColorDescription">Mic ソースの認識と翻訳テキストに適用されます。</sys:String>
    <sys:String x:Key="SteamVrDesktopTextColorTitle">リスニング結果の文字色</sys:String>
    <sys:String x:Key="SteamVrDesktopTextColorDescription">デスクトップまたはアプリ音声リスニングの認識と翻訳テキストに適用されます。</sys:String>
    <sys:String x:Key="SteamVrTextColorHint">#RRGGBB 例: #C8F7C5</sys:String>
    <sys:String x:Key="UiLanguageTitle">UI 言語</sys:String>
    <sys:String x:Key="UiLanguageSwitchTooltip">UI 言語を切り替え</sys:String>
    <sys:String x:Key="UiLanguage_en-US">English</sys:String>
    <sys:String x:Key="UiLanguage_zh-CN">中文</sys:String>
    <sys:String x:Key="UiLanguage_ja-JP">日本語</sys:String>
    <sys:String x:Key="UiLanguage_fr-FR">Français</sys:String>
    <sys:String x:Key="UiLanguage_ru-RU">Русский</sys:String>
    <sys:String x:Key="QuickStartGuideTooltip">クイックスタートを開く</sys:String>
    <sys:String x:Key="QuickStartGuideRecognitionButton">認識設定</sys:String>
    <sys:String x:Key="QuickStartBtnSkip">スキップ</sys:String>
    <sys:String x:Key="QuickStartBtnPrev">戻る</sys:String>
    <sys:String x:Key="QuickStartBtnNext">次へ</sys:String>
    <sys:String x:Key="QuickStartBtnFinish">完了</sys:String>
    <sys:String x:Key="QuickStartStep1Title">VRCLS へようこそ</sys:String>
    <sys:String x:Key="QuickStartStep1Desc">VRCLS は VRChat LinguaSync の略称です。VRChat のリアルタイム翻訳を始めるために、画面を簡単に案内します。</sys:String>
    <sys:String x:Key="QuickStartStep2Title">言語を選択</sys:String>
    <sys:String x:Key="QuickStartStep2Desc">タイトルバーの翻訳アイコンから、クライアントの UI 言語をいつでも切り替えられます。必要なら今ここで選択してください。</sys:String>
    <sys:String x:Key="QuickStartStep3Title">リスニング操作</sys:String>
    <sys:String x:Key="QuickStartStep3Desc">左側はマイク、右側はデスクトップ音声を操作します。細いメーターで入力レベルを確認できます。</sys:String>
    <sys:String x:Key="QuickStartStep4Title">ライブ字幕</sys:String>
    <sys:String x:Key="QuickStartStep4Desc">認識結果と複数の翻訳結果がここに表示されます。字幕をクリックするとすばやくコピーできます。</sys:String>
    <sys:String x:Key="QuickStartStep5Title">手動入力</sys:String>
    <sys:String x:Key="QuickStartStep5Desc">話したくない場合は、ここに文字を入力して翻訳し、VRChat に送信できます。</sys:String>
    <sys:String x:Key="QuickStartStep6Title">設定センター</sys:String>
    <sys:String x:Key="QuickStartStep6Desc">最後に歯車アイコンから、言語、翻訳エンジン、ローカルモデル、VR 連携を設定できます。</sys:String>
</ResourceDictionary>
