### 4.6 C# 调用实现

**修改文件**: `02.VRCLS.Services/Translation/PythonTranslationService.cs`

```csharp
public class EmbeddedTranslatorService : ITranslationService, IDisposable
{
    private Process? _translatorProcess;
    private StreamWriter? _stdin;
    private StreamReader? _stdout;
    private readonly SemaphoreSlim _lock = new(1, 1);
    private readonly string _translatorPath;
    private readonly string _translator; // google, bing, baidu 等
    private bool _isReady;

    public EmbeddedTranslatorService(AppConfig config)
    {
        _translator = config.TranslateService;

        // 查找 translator.exe
        var baseDir = AppDomain.CurrentDomain.BaseDirectory;
        _translatorPath = Path.Combine(baseDir, "translator", "translator.exe");

        if (!File.Exists(_translatorPath))
        {
            _logger.Warning("未找到内嵌翻译器: {Path}", _translatorPath);
        }
    }

    private async Task EnsureProcessStartedAsync()
    {
        if (_translatorProcess != null && !_translatorProcess.HasExited)
            return;

        _translatorProcess = new Process
        {
            StartInfo = new ProcessStartInfo
            {
                FileName = _translatorPath,
                UseShellExecute = false,
                RedirectStandardInput = true,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true,
                StandardOutputEncoding = Encoding.UTF8,
                StandardInputEncoding = Encoding.UTF8
            }
        };

        _translatorProcess.Start();
        _stdin = _translatorProcess.StandardInput;
        _stdout = _translatorProcess.StandardOutput;

        // 等待就绪信号
        var readyLine = await _stdout.ReadLineAsync();
        var ready = JsonSerializer.Deserialize<JsonElement>(readyLine!);
        _isReady = ready.GetProperty("status").GetString() == "ready";

        _logger.Information("内嵌翻译器已启动");
    }

    public async Task<string> TranslateAsync(string text, string targetLang, string sourceLang)
    {
        await _lock.WaitAsync();
        try
        {
            await EnsureProcessStartedAsync();

            var request = new
            {
                cmd = "translate",
                text = text,
                translator = _translator,
                from_lang = sourceLang,
                to_lang = targetLang
            };

            await _stdin!.WriteLineAsync(JsonSerializer.Serialize(request));
            await _stdin.FlushAsync();

            var responseLine = await _stdout!.ReadLineAsync();
            var response = JsonSerializer.Deserialize<JsonElement>(responseLine!);

            if (response.GetProperty("success").GetBoolean())
            {
                return response.GetProperty("text").GetString() ?? string.Empty;
            }

            _logger.Warning("翻译失败: {Error}", response.GetProperty("error").GetString());
            return string.Empty;
        }
        finally
        {
            _lock.Release();
        }
    }

    public void Dispose()
    {
        try
        {
            if (_translatorProcess != null && !_translatorProcess.HasExited)
            {
                _stdin?.WriteLine(JsonSerializer.Serialize(new { cmd = "exit" }));
                _translatorProcess.WaitForExit(3000);
                if (!_translatorProcess.HasExited)
                    _translatorProcess.Kill();
            }
        }
        catch { }

        _stdin?.Dispose();
        _stdout?.Dispose();
        _translatorProcess?.Dispose();
    }
}
```

